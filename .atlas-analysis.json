  "keyFeatures": [
    "AutoML text, image, and tabular classification",
    "Multi-label tagging for text, image, and tabular data",
    "Semantic image and text search",
    "Object detection (center-point and bounding box)",
    "Optical Character Recognition (OCR)",
    "Instant model training in seconds with automatic retraining",
    "REST API with multi-language support (curl, Python, JavaScript, PHP)",
    "Python SDK for programmatic access",
    "Zapier integration and embeddable JavaScript widget",
    "Model pinning for version-controlled invocations",
    "Near-duplicate image removal using semantic search",
    "Collaborative team access per account"
  ],
  "publicApiSurface": [
    "POST /connect/token",
    "POST /v1/functions/<functionId>/invoke (text, image, tabular)",
    "POST /v1/functions",
    "GET /v1/functions",
    "GET /v1/functions/<functionId>",
    "DELETE /v1/functions/<functionId>",
    "POST /v1/functions/<functionId>/labels",
    "GET /v1/functions/<functionId>/labels",
    "PUT /v1/functions/<functionId>/labels/<labelId>",
    "DELETE /v1/functions/<functionId>/labels/<labelId>",
    "POST /v1/functions/<functionId>/samples",
    "GET /v1/functions/<functionId>/samples",
    "DELETE /v1/functions/<functionId>/samples/<sampleId>",
    "PUT /v1/functions/<functionId>/samples/<sampleId>/annotation",
    "DELETE /v1/functions/<functionId>/samples/<sampleId>/annotation",
    "GET /v1/functions/<functionId>/summary",
    "POST /v1/functions/<functionId>/samplesets",
    "GET /v1/functions/<functionId>/samplesets",
    "DELETE /v1/functions/<functionId>/samplesets/<sampleSetId>",
    "POST /v1/functions/<functionId>/fields (tabular)",
    "GET/PUT/DELETE /v1/functions/<functionId>/fields/<fieldId>"
  ]
